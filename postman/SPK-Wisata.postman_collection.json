{
  "info": {
    "_postman_id": "b1e7d9a2-3c4f-4a6b-9d21-spkwisata0001",
    "name": "SPK Wisata API",
    "description": "Koleksi endpoint SPK Wisata, dipisah berdasarkan fungsi & role.\n\nVariabel:\n- base_url: default http://localhost:5000/api/v1 (ganti ke IP laptop saat tes dari HP)\n- server_url: default http://localhost:5000 (untuk health check)\n- admin_token: terisi otomatis setelah Login Admin\n- wisatawan_token: terisi otomatis setelah Login Wisatawan",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth (Publik)",
      "item": [
        {
          "name": "Register Wisatawan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"wisatawan1\",\n  \"email\": \"wisatawan1@mail.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Public. Mendaftarkan akun wisatawan baru."
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.auth && res.auth.token) {",
                  "  pm.collectionVariables.set('admin_token', res.auth.token);",
                  "  console.log('admin_token tersimpan');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mail.com\",\n  \"password\": \"skripsi2026\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login sebagai admin. Token otomatis disimpan ke variabel admin_token."
          }
        },
        {
          "name": "Login Wisatawan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.auth && res.auth.token) {",
                  "  pm.collectionVariables.set('wisatawan_token', res.auth.token);",
                  "  console.log('wisatawan_token tersimpan');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wisatawan1@mail.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login sebagai wisatawan. Token otomatis disimpan ke variabel wisatawan_token."
          }
        }
      ]
    },
    {
      "name": "Auth (Login dulu)",
      "item": [
        {
          "name": "Update Profile (Wisatawan)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{wisatawan_token}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"wisatawan_baru\",\n  \"email\": \"wisatawan1@mail.com\",\n  \"password\": \"passwordbaru123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            },
            "description": "Update profil user yang sedang login (admin/wisatawan). Field opsional."
          }
        },
        {
          "name": "Logout (Wisatawan)",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{wisatawan_token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logout. Token dimasukkan ke blacklist."
          }
        }
      ]
    },
