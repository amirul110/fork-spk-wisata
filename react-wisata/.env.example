# =====================================================
# FRONTEND ENV (Vite) — react-wisata
# =====================================================
# Wajib pakai prefix VITE_ supaya bisa diakses dari
# import.meta.env.* di kode React.
#
# Cara pakai:
#   1. Copy file ini menjadi `.env` di folder yang sama:
#        cp .env.example .env
#   2. Sesuaikan nilai di bawah dengan environment kamu.
#   3. Restart `npm run dev` (Vite hanya membaca .env saat
#      startup, perubahan tidak hot-reload).
# =====================================================

# URL base API backend.
# Backend mount semua route di prefix /api/v1 (lihat backend/src/app.js),
# jadi WAJIB diakhiri dengan /api/v1 (TANPA trailing slash).
#
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Production:
# VITE_API_BASE_URL=https://wisatamagetan.xyz/api/v1
