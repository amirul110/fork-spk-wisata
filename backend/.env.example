# =====================================================
# BACKEND ENV — fork-spk-wisata
# =====================================================
# Cara pakai:
#   1. Copy file ini menjadi `.env` di folder yang sama:
#        cp .env.example .env
#      PENTING: nama file harus persis `.env` (pakai titik
#      di depan). `dotenv` tidak akan membaca file bernama
#      `env` saja.
#   2. Isi nilai sesuai environment kamu.
#   3. Jalankan: npm run dev
# =====================================================

# --- SERVER ---
PORT=5000
NODE_ENV=development

# --- DATABASE (sesuaikan dengan MySQL/XAMPP lokal kamu) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spk_wisata_db

# --- CORS ---
# Pisahkan dengan koma kalau lebih dari satu origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- SECURITY ---
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
DEFAULT_PASSWORD=skripsi2026

# --- TIMEZONE ---
TZ=Asia/Jakarta
