# Copy file ini jadi `.env` (harus pakai titik di depan,
# bukan cuma `env`, karena dotenv hanya baca file `.env`).

# --- SERVER ---
PORT=5000
NODE_ENV=development

# --- DATABASE ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spk_wisata_db

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Saat hosting, ganti baris di atas dengan ini:
# ALLOWED_ORIGINS=https://wisatamagetan.xyz,https://www.wisatamagetan.xyz

# --- SECURITY ---
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
DEFAULT_PASSWORD=skripsi2026

# --- TIMEZONE ---
TZ=Asia/Jakarta
