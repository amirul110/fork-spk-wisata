# Copy file ini jadi `.env` (harus pakai titik di depan,
# bukan cuma `env`, karena dotenv hanya baca file `.env`).

# --- SERVER ---
PORT=5000
NODE_ENV=development
# Saat hosting, ganti NODE_ENV jadi:
# NODE_ENV=production

# --- DATABASE ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spk_wisata_db
# Saat hosting, ganti 4 baris di atas dengan kredensial DB server hosting kamu, contoh:
# DB_HOST=localhost
# DB_USER=wisatama_spk_wisata_db
# DB_PASSWORD=isi_password_dari_panel_hosting
# DB_NAME=wisatama_spk_wisata_db

# --- SECURITY ---
JWT_SECRET=rahasia_skripsi_ganti_aja
DEFAULT_PASSWORD=skripsi2026
# Saat hosting, ganti JWT_SECRET dengan string acak panjang yang RAHASIA, contoh:
# JWT_SECRET=mu_juara_ucl_2026_xyz_abc

# --- TIMEZONE ---
TZ=Asia/Jakarta

# --- CATATAN: CORS ---
# Whitelist CORS sudah HARDCODED di backend/src/config/cors.js
# (sudah include localhost:5173, localhost:5174, wisatamagetan.xyz,
# dan www.wisatamagetan.xyz). Jadi tidak perlu set ALLOWED_ORIGINS di sini.
